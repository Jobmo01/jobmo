# =============================================================================
# JobMo — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Found in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Bypasses RLS — used only in
# lib/supabase/server.ts's createServiceRoleClient(), for trusted server-only
# operations (webhooks, cron jobs, admin actions after a permission check).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site --------------------------------------------------------------------
# Used to build OAuth/password-reset redirect URLs. Set to your deployed
# Netlify URL in production (e.g. https://jobmo.netlify.app), localhost in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OpenAI (wired up starting Phase 4 — AI Engine) --------------------------
OPENAI_API_KEY=sk-your-openai-key
# Optional — defaults to gpt-4o-mini if unset. Any OpenAI chat model works.
OPENAI_MODEL=gpt-4o-mini

# --- Brevo (email marketing contact sync) -------------------------------------
# Optional — registration works completely normally without these, the sync
# just silently skips itself. Get the API key from Brevo → Settings → SMTP &
# API → API Keys. Get each list ID from the list's page in Brevo → Contacts →
# Lists (shown near the top, e.g. "#3").
# BREVO_API_KEY=
# BREVO_APPLICANT_LIST_ID=
# BREVO_EMPLOYER_LIST_ID=

# --- Google Analytics ----------------------------------------------------------
# Optional — the site works completely normally without this, GA simply isn't
# loaded. Get your Measurement ID (starts with "G-") from
# analytics.google.com → Admin → Data Streams → your web stream.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google OAuth --------------------------------------------------------------
# Configure this provider in Supabase Dashboard → Authentication → Providers → Google
# (Client ID / Secret are entered there, not here — Supabase handles the OAuth flow)

# --- Future: payments (Stripe-ready architecture, not implemented yet) -------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
